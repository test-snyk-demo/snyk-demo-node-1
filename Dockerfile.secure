# Hardened image for the goof demo app (the upstream Dockerfile stays for comparison).
#
#  - Multi-stage: dependencies are installed and the front-end bundle is built in a full Node image;
#    the runtime image only gets the app and its production dependencies.
#  - Runtime is node:22.23.5-alpine3.24 (Snyk's base image recommendation) with npm/corepack/yarn removed, running as non-root uid 10001.
#  - `npm ci` from the lockfile with install scripts disabled: reproducible, no `npm update`.
#  - Only the app port is exposed; the Node inspector port (9229) is gone.
#  - Pin the base images by digest for production (`docker buildx imagetools inspect <image>`).

FROM node:22.23.5-alpine3.24 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build \
 && npm prune --omit=dev \
 && rm -rf .git .github k8s deploy exploits tests docker-compose.yml Dockerfile* *.md

FROM node:22.23.5-alpine3.24
# Snyk fix: base image upgrade recommended by `snyk container test` (node:22-bookworm-slim had
# 1 critical + 4 high OS issues; this Alpine tag has 0 critical, 0 high). Hardened by hand:
# no npm/corepack/yarn at runtime, a dedicated non-root user, read-only root filesystem in Kubernetes.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && addgroup -S -g 10001 goof \
 && adduser -S -D -H -u 10001 -G goof -s /sbin/nologin goof
WORKDIR /app
COPY --from=build --chown=10001:10001 /app /app
ENV NODE_ENV=production \
    NODE_OPTIONS=--openssl-legacy-provider \
    PORT=3001
USER 10001:10001
EXPOSE 3001
# The app writes uploads under /tmp, which Kubernetes mounts as an emptyDir (read-only root).
CMD ["node", "app.js"]
